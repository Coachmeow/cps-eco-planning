generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServiceTeam {
  id        Int    @id @default(autoincrement())
  code      String @unique
  name      String
  sortOrder Int    @default(999)  // ลำดับการแสดงผล (ทีมใหม่ที่ไม่ตั้งค่าจะต่อท้าย)

  equipmentTypes   EquipmentType[]
  employees        Employee[]
  staffAssignments StaffAssignment[]
  subTeams         SubTeam[]

  @@map("service_teams")
}

// ทีมย่อยในทีมใหญ่ (เช่น ST แบ่งเป็น ST-1..ST-4) — ใช้จัดกลุ่ม/เรียงลำดับ/แสดงผล
model SubTeam {
  id        Int         @id @default(autoincrement())
  teamId    Int
  team      ServiceTeam @relation(fields: [teamId], references: [id])
  name      String
  sortOrder Int         @default(1)
  members   Employee[]  @relation("SubTeamMembers")

  @@index([teamId, sortOrder])
  @@map("sub_teams")
}

model EquipmentType {
  id            Int         @id @default(autoincrement())
  code          String      @unique
  name          String
  primaryTeamId Int
  primaryTeam   ServiceTeam @relation(fields: [primaryTeamId], references: [id])

  equipment Equipment[]

  @@map("equipment_types")
}

model Equipment {
  id           Int             @id @default(autoincrement())
  typeId       Int
  type         EquipmentType   @relation(fields: [typeId], references: [id])
  serialNo     String?
  internalNo   String?
  isRental        Boolean         @default(false)
  rentalVendor    String?
  rentalStartDate DateTime?       @db.Date
  rentalEndDate   DateTime?       @db.Date
  status          EquipmentStatus @default(ACTIVE)
  notes           String?
  // ฐานข้อมูลเครื่องมือออฟฟิศ
  photoUrl        String?           // base64 data URL หรือ URL ภายนอก
  brand           String?
  model           String?
  vendor          String?           // ผู้ขายหลัก
  purchaseDate    DateTime?         @db.Date
  purchasePrice   Int?              // บาท
  lifespanYears   Int?              // อายุการใช้งานประเมิน (ปี)
  calDueDate      DateTime?         @db.Date  // กำหนด Calibrate ครั้งถัดไป

  assignments EquipmentAssignment[]
  events      EquipmentEvent[]

  @@map("equipment")
}

enum EquipmentStatus {
  ACTIVE
  CALIBRATING
  BROKEN
  RETIRED
}

model Employee {
  id            Int         @id @default(autoincrement())
  employeeNo    String?     @unique
  fullName      String
  nickname      String?
  primaryTeamId Int
  primaryTeam   ServiceTeam @relation(fields: [primaryTeamId], references: [id])
  isActive      Boolean     @default(true)
  phone         String?     // เบอร์โทร
  photoUrl      String?     // base64 data URL หรือ URL ภายนอก
  birthDate     DateTime?   @db.Date
  startDate     DateTime?   @db.Date
  eduField      String?     // สาขา/คณะ
  eduInstitute  String?     // สถาบัน
  // ทีมย่อย (optional) — หัวหน้าอยู่บนสุด, เรียงตาม subTeam.sortOrder แล้ว subTeamOrder
  subTeamId     Int?
  subTeam       SubTeam?    @relation("SubTeamMembers", fields: [subTeamId], references: [id])
  subTeamOrder  Int         @default(999)
  isSubLeader   Boolean     @default(false)

  siteAccess  EmployeeSiteAccess[]
  assignments StaffAssignment[]
  user        User?
  vehicleBookings VehicleBooking[] @relation("VehicleDriver")
  vehicleLogs     VehicleLog[]     @relation("VehicleLogDriver")
  vehicleTrips    VehicleTrip[]    @relation("VehicleTripDriver")
  cemsRequests    CemsPartRequest[] @relation("CemsRequester")

  @@map("employees")
}

enum UserRole {
  ADMIN
  MANAGER
  MAINTENANCE
  GENERAL
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  role         UserRole  @default(GENERAL)
  isActive     Boolean   @default(true)
  cemsAccess   Boolean   @default(false)   // สิทธิ์เข้าโมดูล CEMS Service (ADMIN เข้าได้เสมอ)
  employeeId   Int?      @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime  @default(now())

  @@map("users")
}

model EmployeeSiteAccess {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  siteCode   String
  expiryDate DateTime

  @@unique([employeeId, siteCode])
  @@map("employee_site_access")
}

model Site {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  name           String
  clientName     String?
  province       String?
  region         String?
  color          String?  @default("emerald")
  requiresAccess String[]

  staffAssignments     StaffAssignment[]
  equipmentAssignments EquipmentAssignment[]
  vehicleBookings      VehicleBooking[]
  vehicleLogs          VehicleLog[]
  vehicleTrips         VehicleTrip[]

  @@map("sites")
}

model StaffAssignment {
  id            Int              @id @default(autoincrement())
  employeeId    Int
  employee      Employee         @relation(fields: [employeeId], references: [id])
  assignedDate  DateTime         @db.Date
  siteId        Int?
  site          Site?            @relation(fields: [siteId], references: [id])
  serviceTypeId Int?
  serviceType   ServiceTeam?     @relation(fields: [serviceTypeId], references: [id])
  isCrossTeam   Boolean          @default(false)
  estimatedDays Decimal          @default(1) @db.Decimal(4, 1)
  status        AssignmentStatus @default(FIELD)
  notes         String?
  isLocked      Boolean          @default(false)
  parentId      Int?
  parent        StaffAssignment?  @relation("MultiDay", fields: [parentId], references: [id])
  children      StaffAssignment[] @relation("MultiDay")

  equipmentAssignments EquipmentAssignment[]
  vehicleBookings      VehicleBooking[]

  @@index([employeeId, assignedDate])
  @@index([assignedDate])
  @@map("staff_assignments")
}

enum AssignmentStatus {
  FIELD
  OFFICE
  LEAVE
  HOLIDAY
  CAL
  TRAINING
}

model EquipmentAssignment {
  id                Int              @id @default(autoincrement())
  equipmentId       Int
  equipment         Equipment        @relation(fields: [equipmentId], references: [id])
  assignedDate      DateTime         @db.Date
  siteId            Int?
  site              Site?            @relation(fields: [siteId], references: [id])
  staffAssignmentId Int?
  staffAssignment   StaffAssignment? @relation(fields: [staffAssignmentId], references: [id])
  notes             String?
  isLocked          Boolean          @default(false)
  estimatedDays     Int              @default(1)
  parentId          Int?
  parent            EquipmentAssignment?  @relation("EqMultiDay", fields: [parentId], references: [id])
  children          EquipmentAssignment[] @relation("EqMultiDay")

  @@index([equipmentId, assignedDate])
  @@index([assignedDate])
  @@map("equipment_assignments")
}

model Holiday {
  id   Int      @id @default(autoincrement())
  date DateTime @unique @db.Date
  name String

  @@map("holidays")
}

enum EquipmentEventType {
  REPAIR
  CALIBRATION
}

// ใบงานซ่อม/Calibrate — ส่ง → กำหนด → รับกลับ (returnedDate = null คือยังไม่กลับ)
model EquipmentEvent {
  id           Int                @id @default(autoincrement())
  equipmentId  Int
  equipment    Equipment          @relation(fields: [equipmentId], references: [id])
  type         EquipmentEventType
  sentDate     DateTime           @db.Date
  expectedDate DateTime?          @db.Date  // กำหนดรับกลับ (ซ่อม) / กำหนดเสร็จ (Cal)
  returnedDate DateTime?          @db.Date  // วันรับกลับจริง
  nextDueDate  DateTime?          @db.Date  // (Cal) กำหนด Cal ครั้งถัดไป → อัปเดต equipment.calDueDate ตอนรับกลับ
  vendor       String?
  cost         Int?               // ค่าใช้จ่าย (บาท, optional)
  notes        String?
  createdAt    DateTime           @default(now())

  @@index([equipmentId])
  @@index([returnedDate])
  @@map("equipment_events")
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum VehiclePurpose {
  FIELD
  SAMPLE
  DELIVERY
  SHUTTLE
  OTHER
}

model Vehicle {
  id           Int           @id @default(autoincrement())
  licensePlate String        // ทะเบียน
  name         String?       // ชื่อเรียก/รหัสภายใน
  vehicleType  String?       // กระบะ/ตู้/เก๋ง
  brand        String?
  model        String?
  seats        Int?
  photoUrl     String?
  status       VehicleStatus @default(ACTIVE)
  notes        String?
  qrToken      String?       @unique

  bookings VehicleBooking[]
  logs     VehicleLog[]
  trips    VehicleTrip[]

  @@map("vehicles")
}

// ทริปการใช้รถ: ออกรถ (mileageOut+ต้นทาง) → จอดรถ (mileageIn+ปลายทาง)
model VehicleTrip {
  id          Int             @id @default(autoincrement())
  vehicleId   Int
  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id])
  driverId    Int?
  driver      Employee?       @relation("VehicleTripDriver", fields: [driverId], references: [id])
  driverName  String?
  purpose     VehiclePurpose?
  siteId      Int?
  site        Site?           @relation(fields: [siteId], references: [id])
  bookingId   Int?
  booking     VehicleBooking? @relation("VBTrip", fields: [bookingId], references: [id])
  forDate     DateTime        @db.Date
  origin      String?
  mileageOut  Int
  startedAt   DateTime        @default(now())
  destination String?
  mileageIn   Int?                          // null = ยังไม่ปิดทริป
  endedAt     DateTime?
  nonField    Boolean         @default(false)
  reason      String?
  mismatch    Boolean         @default(false)
  expectedMileage Int?
  notes       String?

  @@index([vehicleId, startedAt])
  @@index([mileageIn])
  @@map("vehicle_trips")
}

enum VehicleLogType {
  USE
  REFUEL
}

model VehicleLog {
  id        Int             @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id])
  type      VehicleLogType
  mileage   Int                          // เลขไมล์ที่อ่านได้
  loggedAt  DateTime        @default(now())
  forDate   DateTime        @db.Date     // วันที่ใช้
  driverId  Int?
  driver    Employee?       @relation("VehicleLogDriver", fields: [driverId], references: [id])
  driverName String?
  purpose   VehiclePurpose?
  siteId    Int?
  site      Site?           @relation(fields: [siteId], references: [id])
  bookingId Int?
  booking   VehicleBooking? @relation(fields: [bookingId], references: [id])
  origin       String?
  destination  String?
  nonField     Boolean      @default(false)   // ใช้นอกงาน
  reason       String?
  fuelLiters        Float?
  fuelPricePerLiter Float?
  fuelCost          Float?
  mismatch        Boolean   @default(false)   // แจ้งไมล์ไม่ตรง
  expectedMileage Int?                        // เลขในระบบตอนนั้น (ก่อนแก้)
  notes     String?

  @@index([vehicleId, loggedAt])
  @@map("vehicle_logs")
}

model VehicleBooking {
  id                Int              @id @default(autoincrement())
  vehicleId         Int
  vehicle           Vehicle          @relation(fields: [vehicleId], references: [id])
  assignedDate      DateTime         @db.Date
  estimatedDays     Int              @default(1)
  parentId          Int?
  parent            VehicleBooking?  @relation("VBMultiDay", fields: [parentId], references: [id])
  children          VehicleBooking[] @relation("VBMultiDay")
  purpose           VehiclePurpose   @default(FIELD)
  siteId            Int?
  site              Site?            @relation(fields: [siteId], references: [id])
  destination       String?          // ปลายทางพิมพ์อิสระ (งานนอก)
  staffAssignmentId Int?
  staffAssignment   StaffAssignment? @relation(fields: [staffAssignmentId], references: [id])
  driverId          Int?
  driver            Employee?        @relation("VehicleDriver", fields: [driverId], references: [id])
  driverName        String?          // คนขับนอกระบบ
  notes             String?
  logs              VehicleLog[]
  trips             VehicleTrip[]    @relation("VBTrip")

  @@index([vehicleId, assignedDate])
  @@index([assignedDate])
  @@map("vehicle_bookings")
}

// ══ CEMS Service Module ═══════════════════════════════════════

enum CemsOwnership {
  POOL_OWN     // หน่วยงานซื้อเอง (pool)
  POOL_LEGACY  // ของเก่าจากไซต์ นำมา pool
  CUSTOMER     // ของลูกค้าประจำไซต์
}

enum CemsAnalyzerStatus {
  READY
  IN_USE
  REPAIR
  RETIRED
}

enum CemsEventType {
  REPAIR  // ส่งซ่อม
  RETURN  // รับคืน
  MOVE    // ย้ายที่
  PM      // เข้า PM
  ISSUE   // แจ้งอาการผิดปกติ (จาก QR)
}

model CemsSite {
  id       Int     @id @default(autoincrement())
  code     String  @unique // SKK3, STL5, CFB, ...
  name     String?
  isManual Boolean @default(false)

  analyzers     CemsAnalyzer[]      @relation("CurrentSite")
  homeAnalyzers CemsAnalyzer[]      @relation("HomeSite")
  events        CemsAnalyzerEvent[] @relation("EvtSite")
  partTxns      CemsPartTxn[]       @relation("PartTxnSite")
  partRequests  CemsPartRequest[]   @relation("ReqSite")

  @@map("cems_sites")
}

model CemsAnalyzer {
  id              Int                @id @default(autoincrement())
  tag             String             // ชื่อเรียก/รหัสเครื่อง
  brand           String?
  model           String?
  serialNo        String?
  parameter       String?            // วัดอะไร เช่น SO2/NOx/CO/O2
  ownership       CemsOwnership      @default(POOL_OWN)
  homeSiteId      Int?               // เครื่องลูกค้า = ไซต์เจ้าของ ; pool = null
  homeSite        CemsSite?          @relation("HomeSite", fields: [homeSiteId], references: [id])
  currentSiteId   Int?               // อยู่ที่ไหนตอนนี้ ; null = อยู่หน่วยงาน (pool)
  currentSite     CemsSite?          @relation("CurrentSite", fields: [currentSiteId], references: [id])
  status          CemsAnalyzerStatus @default(READY)
  receivedDate    DateTime?          @db.Date // วันรับเข้า → นับอายุใช้งาน
  statusUpdatedAt DateTime           @default(now())
  qrToken         String?            @unique
  photoUrl        String?
  notes           String?

  events       CemsAnalyzerEvent[]
  partTxns     CemsPartTxn[]
  partRequests CemsPartRequest[]  @relation("ReqAnalyzer")

  @@map("cems_analyzers")
}

model CemsAnalyzerEvent {
  id         Int           @id @default(autoincrement())
  analyzerId Int
  analyzer   CemsAnalyzer  @relation(fields: [analyzerId], references: [id])
  type       CemsEventType
  eventDate  DateTime      @db.Date
  symptom    String?       // อาการ/สาเหตุส่งซ่อม
  action     String?       // สิ่งที่ทำ/ผลรับคืน
  siteId     Int?          // MOVE: ไปไซต์ไหน (null = กลับหน่วยงาน) / ISSUE: แจ้งจากไซต์ไหน
  site       CemsSite?     @relation("EvtSite", fields: [siteId], references: [id])
  vendor     String?
  reporter   String?
  notes      String?
  createdAt  DateTime      @default(now())

  @@index([analyzerId, eventDate])
  @@map("cems_analyzer_events")
}

// ── CEMS เฟส 2: Stock อะไหล่ ──────────────────────────────────

enum CemsTxnType {
  IN     // รับเข้า (มีต้นทุน/หน่วย)
  OUT    // เบิกออก (ผูกไซต์/เครื่อง/ใบเสนอราคา)
  ADJUST // ปรับยอด (qty เป็น +/- ได้)
}

model CemsSparePart {
  id       Int     @id @default(autoincrement())
  code     String  @unique // BEK001, DUR003, ...
  name     String
  brand    String? // BEKO / Durag / OPSIS / อื่นๆ
  unit     String? // ชิ้น/ชุด/เมตร/ม้วน
  minStock Int     @default(0) // Reorder level
  location String? // ตำแหน่งจัดเก็บ A1-A18, F1-F4
  refCost  Float?  // ราคาอ้างอิงล่าสุด (อัปเดตอัตโนมัติตอนรับเข้า) → มูลค่า = stock × refCost
  isActive Boolean @default(true)
  notes    String?
  qrToken  String? @unique // QR แขวนที่ชั้นเก็บ → สแกนเปิดหน้าขอเบิก

  txns     CemsPartTxn[]
  requests CemsPartRequest[]

  @@map("cems_spare_parts")
}

enum CemsRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// คำขอเบิกจากการสแกน QR (ไม่แตะ stock จนกว่า CEMS Admin อนุมัติ → สร้าง OUT txn)
model CemsPartRequest {
  id          Int               @id @default(autoincrement())
  partId      Int
  part        CemsSparePart     @relation(fields: [partId], references: [id])
  qty         Int
  requesterId Int               // ต้องเป็นพนักงาน
  requester   Employee          @relation("CemsRequester", fields: [requesterId], references: [id])
  siteId      Int?
  site        CemsSite?         @relation("ReqSite", fields: [siteId], references: [id])
  manualSite  String?
  analyzerId  Int?
  analyzer    CemsAnalyzer?     @relation("ReqAnalyzer", fields: [analyzerId], references: [id])
  quoteNo     String?
  note        String?
  status      CemsRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  decidedAt   DateTime?
  decidedBy   String?
  rejectReason String?
  txnId       Int?              // OUT txn ที่สร้างตอนอนุมัติ

  @@index([status, createdAt])
  @@map("cems_part_requests")
}

model CemsPartTxn {
  id         Int           @id @default(autoincrement())
  partId     Int
  part       CemsSparePart @relation(fields: [partId], references: [id])
  type       CemsTxnType
  qty        Float         // IN/OUT บวกเสมอ ; ADJUST เป็น +/- ได้
  unitCost   Float?        // IN: ต้นทุนต่อหน่วยของล็อตนี้
  txnDate    DateTime      @db.Date
  siteId     Int?          // OUT: เบิกไปไซต์ไหน
  site       CemsSite?     @relation("PartTxnSite", fields: [siteId], references: [id])
  manualSite String?       // ไซต์นอกฐานข้อมูล (พิมพ์เอง)
  analyzerId Int?          // OUT: ใช้กับเครื่องไหน
  analyzer   CemsAnalyzer? @relation(fields: [analyzerId], references: [id])
  quoteNo    String?       // เลขใบเสนอราคาที่เสนอลูกค้า
  person     String?       // ผู้เบิก/ผู้รับเข้า
  notes      String?
  createdAt  DateTime      @default(now())

  @@index([partId, txnDate])
  @@map("cems_part_txns")
}
