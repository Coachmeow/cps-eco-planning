generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServiceTeam {
  id        Int    @id @default(autoincrement())
  code      String @unique
  name      String
  sortOrder Int    @default(999)  // ลำดับการแสดงผล (ทีมใหม่ที่ไม่ตั้งค่าจะต่อท้าย)

  equipmentTypes   EquipmentType[]
  employees        Employee[]
  staffAssignments StaffAssignment[]

  @@map("service_teams")
}

model EquipmentType {
  id            Int         @id @default(autoincrement())
  code          String      @unique
  name          String
  primaryTeamId Int
  primaryTeam   ServiceTeam @relation(fields: [primaryTeamId], references: [id])

  equipment Equipment[]

  @@map("equipment_types")
}

model Equipment {
  id           Int             @id @default(autoincrement())
  typeId       Int
  type         EquipmentType   @relation(fields: [typeId], references: [id])
  serialNo     String?
  internalNo   String?
  isRental        Boolean         @default(false)
  rentalVendor    String?
  rentalStartDate DateTime?       @db.Date
  rentalEndDate   DateTime?       @db.Date
  status          EquipmentStatus @default(ACTIVE)
  notes           String?
  // ฐานข้อมูลเครื่องมือออฟฟิศ
  photoUrl        String?           // base64 data URL หรือ URL ภายนอก
  brand           String?
  model           String?
  vendor          String?           // ผู้ขายหลัก
  purchaseDate    DateTime?         @db.Date
  purchasePrice   Int?              // บาท
  lifespanYears   Int?              // อายุการใช้งานประเมิน (ปี)
  calDueDate      DateTime?         @db.Date  // กำหนด Calibrate ครั้งถัดไป

  assignments EquipmentAssignment[]
  events      EquipmentEvent[]

  @@map("equipment")
}

enum EquipmentStatus {
  ACTIVE
  CALIBRATING
  BROKEN
  RETIRED
}

model Employee {
  id            Int         @id @default(autoincrement())
  employeeNo    String?     @unique
  fullName      String
  nickname      String?
  primaryTeamId Int
  primaryTeam   ServiceTeam @relation(fields: [primaryTeamId], references: [id])
  isActive      Boolean     @default(true)
  phone         String?     // เบอร์โทร
  photoUrl      String?     // base64 data URL หรือ URL ภายนอก
  birthDate     DateTime?   @db.Date
  startDate     DateTime?   @db.Date
  eduField      String?     // สาขา/คณะ
  eduInstitute  String?     // สถาบัน

  siteAccess  EmployeeSiteAccess[]
  assignments StaffAssignment[]
  user        User?
  vehicleBookings VehicleBooking[] @relation("VehicleDriver")
  vehicleLogs     VehicleLog[]     @relation("VehicleLogDriver")

  @@map("employees")
}

enum UserRole {
  ADMIN
  MANAGER
  MAINTENANCE
  GENERAL
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String
  role         UserRole  @default(GENERAL)
  isActive     Boolean   @default(true)
  employeeId   Int?      @unique
  employee     Employee? @relation(fields: [employeeId], references: [id])
  createdAt    DateTime  @default(now())

  @@map("users")
}

model EmployeeSiteAccess {
  id         Int      @id @default(autoincrement())
  employeeId Int
  employee   Employee @relation(fields: [employeeId], references: [id])
  siteCode   String
  expiryDate DateTime

  @@unique([employeeId, siteCode])
  @@map("employee_site_access")
}

model Site {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  name           String
  clientName     String?
  province       String?
  region         String?
  color          String?  @default("emerald")
  requiresAccess String[]

  staffAssignments     StaffAssignment[]
  equipmentAssignments EquipmentAssignment[]
  vehicleBookings      VehicleBooking[]
  vehicleLogs          VehicleLog[]

  @@map("sites")
}

model StaffAssignment {
  id            Int              @id @default(autoincrement())
  employeeId    Int
  employee      Employee         @relation(fields: [employeeId], references: [id])
  assignedDate  DateTime         @db.Date
  siteId        Int?
  site          Site?            @relation(fields: [siteId], references: [id])
  serviceTypeId Int?
  serviceType   ServiceTeam?     @relation(fields: [serviceTypeId], references: [id])
  isCrossTeam   Boolean          @default(false)
  estimatedDays Decimal          @default(1) @db.Decimal(4, 1)
  status        AssignmentStatus @default(FIELD)
  notes         String?
  isLocked      Boolean          @default(false)
  parentId      Int?
  parent        StaffAssignment?  @relation("MultiDay", fields: [parentId], references: [id])
  children      StaffAssignment[] @relation("MultiDay")

  equipmentAssignments EquipmentAssignment[]
  vehicleBookings      VehicleBooking[]

  @@index([employeeId, assignedDate])
  @@index([assignedDate])
  @@map("staff_assignments")
}

enum AssignmentStatus {
  FIELD
  OFFICE
  LEAVE
  HOLIDAY
  CAL
  TRAINING
}

model EquipmentAssignment {
  id                Int              @id @default(autoincrement())
  equipmentId       Int
  equipment         Equipment        @relation(fields: [equipmentId], references: [id])
  assignedDate      DateTime         @db.Date
  siteId            Int?
  site              Site?            @relation(fields: [siteId], references: [id])
  staffAssignmentId Int?
  staffAssignment   StaffAssignment? @relation(fields: [staffAssignmentId], references: [id])
  notes             String?
  isLocked          Boolean          @default(false)
  estimatedDays     Int              @default(1)
  parentId          Int?
  parent            EquipmentAssignment?  @relation("EqMultiDay", fields: [parentId], references: [id])
  children          EquipmentAssignment[] @relation("EqMultiDay")

  @@index([equipmentId, assignedDate])
  @@index([assignedDate])
  @@map("equipment_assignments")
}

model Holiday {
  id   Int      @id @default(autoincrement())
  date DateTime @unique @db.Date
  name String

  @@map("holidays")
}

enum EquipmentEventType {
  REPAIR
  CALIBRATION
}

// ใบงานซ่อม/Calibrate — ส่ง → กำหนด → รับกลับ (returnedDate = null คือยังไม่กลับ)
model EquipmentEvent {
  id           Int                @id @default(autoincrement())
  equipmentId  Int
  equipment    Equipment          @relation(fields: [equipmentId], references: [id])
  type         EquipmentEventType
  sentDate     DateTime           @db.Date
  expectedDate DateTime?          @db.Date  // กำหนดรับกลับ (ซ่อม) / กำหนดเสร็จ (Cal)
  returnedDate DateTime?          @db.Date  // วันรับกลับจริง
  nextDueDate  DateTime?          @db.Date  // (Cal) กำหนด Cal ครั้งถัดไป → อัปเดต equipment.calDueDate ตอนรับกลับ
  vendor       String?
  cost         Int?               // ค่าใช้จ่าย (บาท, optional)
  notes        String?
  createdAt    DateTime           @default(now())

  @@index([equipmentId])
  @@index([returnedDate])
  @@map("equipment_events")
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum VehiclePurpose {
  FIELD
  SAMPLE
  DELIVERY
  SHUTTLE
  OTHER
}

model Vehicle {
  id           Int           @id @default(autoincrement())
  licensePlate String        // ทะเบียน
  name         String?       // ชื่อเรียก/รหัสภายใน
  vehicleType  String?       // กระบะ/ตู้/เก๋ง
  brand        String?
  model        String?
  seats        Int?
  photoUrl     String?
  status       VehicleStatus @default(ACTIVE)
  notes        String?
  qrToken      String?       @unique

  bookings VehicleBooking[]
  logs     VehicleLog[]

  @@map("vehicles")
}

enum VehicleLogType {
  USE
  REFUEL
}

model VehicleLog {
  id        Int             @id @default(autoincrement())
  vehicleId Int
  vehicle   Vehicle         @relation(fields: [vehicleId], references: [id])
  type      VehicleLogType
  mileage   Int                          // เลขไมล์ที่อ่านได้
  loggedAt  DateTime        @default(now())
  forDate   DateTime        @db.Date     // วันที่ใช้
  driverId  Int?
  driver    Employee?       @relation("VehicleLogDriver", fields: [driverId], references: [id])
  driverName String?
  purpose   VehiclePurpose?
  siteId    Int?
  site      Site?           @relation(fields: [siteId], references: [id])
  bookingId Int?
  booking   VehicleBooking? @relation(fields: [bookingId], references: [id])
  origin       String?
  destination  String?
  nonField     Boolean      @default(false)   // ใช้นอกงาน
  reason       String?
  fuelLiters        Float?
  fuelPricePerLiter Float?
  fuelCost          Float?
  mismatch        Boolean   @default(false)   // แจ้งไมล์ไม่ตรง
  expectedMileage Int?                        // เลขในระบบตอนนั้น (ก่อนแก้)
  notes     String?

  @@index([vehicleId, loggedAt])
  @@map("vehicle_logs")
}

model VehicleBooking {
  id                Int              @id @default(autoincrement())
  vehicleId         Int
  vehicle           Vehicle          @relation(fields: [vehicleId], references: [id])
  assignedDate      DateTime         @db.Date
  estimatedDays     Int              @default(1)
  parentId          Int?
  parent            VehicleBooking?  @relation("VBMultiDay", fields: [parentId], references: [id])
  children          VehicleBooking[] @relation("VBMultiDay")
  purpose           VehiclePurpose   @default(FIELD)
  siteId            Int?
  site              Site?            @relation(fields: [siteId], references: [id])
  destination       String?          // ปลายทางพิมพ์อิสระ (งานนอก)
  staffAssignmentId Int?
  staffAssignment   StaffAssignment? @relation(fields: [staffAssignmentId], references: [id])
  driverId          Int?
  driver            Employee?        @relation("VehicleDriver", fields: [driverId], references: [id])
  driverName        String?          // คนขับนอกระบบ
  notes             String?
  logs              VehicleLog[]

  @@index([vehicleId, assignedDate])
  @@index([assignedDate])
  @@map("vehicle_bookings")
}
